      "blocks": [
        {
          "id": "blk_mgf5nv364m",
          "type": "text",
          "v": 1,
          "fields": {
            "content": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "attrs": {
                    "preset": "small"
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "The essence of the work:",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " Thresholding is a supportive container to mark and actively engage a life transition. Within the overwhelm of the old story falling apart, lay the seeds of a new story germinating. These seeds take root as you cross the threshold and nourish your innate wisdom and inner resourcefulness — as you unfold, discover and express your whole self."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "attrs": {
                    "preset": "small"
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "Braiding depth psychology, mentoring/coaching and nature-based ceremonial work — we will collaboratively unfold your journey by listening to the threshold calling you. Navigating the ordeal of this life passage with devotion and care will help clarify values, and support the embodiment of innate resourcefulness, creativity and your unique genius."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "attrs": {
                    "preset": "small"
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "Meeting one-on-one online (with the possibility of in person work in the Blue Ridge Mountains of Virginia)."
                    }
                  ]
                }
              ]
            }
          }
        },
        {
          "id": "blk_bdsv0ce4s0",
          "type": "button",
          "v": 1,
          "fields": {
            "label": "Connect for a discovery session",
            "link": {
              "type": "url",
              "url": "https://calendly.com/thresholding"
            },
            "role": "primary"
          },
          "style": {
            "align": {
              "d": "center"
            }
          }
        },
        {
          "id": "blk_mfsdh48p8b",
          "type": "text",
          "v": 1,
          "fields": {
            "content": {
              "type": "doc",
              "content": [
                {
                  "type": "heading",
                  "attrs": {
                    "level": 1,
                    "preset": "h4"
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "Are you a Gen Z or Millennial longing for a guided space to embody more of who you authentically are and to discover who you are becoming?"
                    }
                  ]
                }
              ]
            }
          },
          "style": {
            "align": {
              "d": "center"
            }
          }
        }
      ]
