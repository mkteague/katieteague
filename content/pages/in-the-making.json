                },
                {
                  "type": "paragraph",
                  "attrs": {
                    "preset": "small"
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "Note: There are interviewees in the trailer not listed above. These are prior interviews and may or may not be in the final film. This list is interviews that have taken place recently or are scheduled. There may also be other future interviews (outreach still ongoing). All the interviews will be made available (separate from the film) in their entirety as well.",
                      "marks": [
                        {
                          "type": "italic"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Tone & Style:",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "bulletList",
                  "content": [
                    {
                      "type": "listItem",
                      "content": [
                        {
                          "type": "paragraph",
                          "content": [
                            {
                              "type": "text",
                              "text": "Cinematic, intellectual, and contemplative."
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "listItem",
                      "content": [
                        {
                          "type": "paragraph",
                          "content": [
                            {
                              "type": "text",
                              "text": "Each act will be composed of alternating interviews and high-quality, poetically narrated animation that gives a more experiential felt-sense of the terrain being traversed."
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "listItem",
                      "content": [
                        {
                          "type": "paragraph",
                          "content": [
                            {
                              "type": "text",
                              "text": "Uses visual metaphors: roots, mycelium, rivers, pulses, spirals, cracks, crossroads."
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "listItem",
                      "content": [
                        {
                          "type": "paragraph",
                          "content": [
                            {
                              "type": "text",
                              "text": "Oscillates between quiet depth and passionate urgency."
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "listItem",
                      "content": [
                        {
                          "type": "paragraph",
                          "content": [
                            {
                              "type": "text",
                              "text": "The film is polyphonic, a chorus of voices forming a coherent arc."
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
