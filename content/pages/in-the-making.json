        {
          "id": "blk_trf8j04tgd",
          "type": "text",
          "v": 1,
          "fields": {
            "content": {
              "type": "doc",
              "content": [
                {
                  "type": "heading",
                  "attrs": {
                    "level": 4
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "Help us make this film!"
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Donations of $500 and above can be funneled through our fiscal sponsor (Open Field Awakening 501c3) for tax credit if requested. "
                    },
                    {
                      "type": "text",
                      "text": "Contact us",
                      "marks": [
                        {
                          "type": "link",
                          "attrs": {
                            "href": "mailto:katieteague@protonmail.com",
                            "newTab": true
                          }
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " and we will set that in motion!"
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Donations of $5000 or greater will be listed as an Executive Producer (as an individual or organization or collective)."
                    }
                  ]
                },
