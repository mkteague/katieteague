                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "The planet is at a threshold. Are you?"
                    }
                  ]
                },
                {
                  "type": "heading",
                  "attrs": {
                    "level": 3
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "bespoke rites of passage for a time between worlds"
                    }
                  ]
                }
              ]
            }
          },
          "style": {
            "align": {
              "d": "center"
            }
          }
        }
      ]
    },
