      "blocks": [
        {
          "id": "blk_txgz5yycyc",
          "type": "quote",
          "v": 1,
          "fields": {
            "quote": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "At any time you can ask yourself: At which threshold am I now standing? At this time in my life, what am I leaving? Where am I about to enter?"
                    }
                  ]
                }
              ]
            },
            "attribution": "John O'Donohue"
          }
        },
