              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "It depends. A 1-3 minute video can cost $1000-$3000. Longer videos or short documentaries will be priced according to scope."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "*Filming on location will incur additional costs*"
                    }
